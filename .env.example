# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=triage
DATABASE_PASSWORD=triage
DATABASE_NAME=ai_triage

# API
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# AI adapter: mock (default) | live
AI_PROVIDER=mock
# Optional live provider (unused in mock mode)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Confidence threshold: below this → Needs Review
AI_CONFIDENCE_THRESHOLD=0.70

# Paths (relative to repo root or absolute)
FIXTURES_DIR=../../fixtures

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001
